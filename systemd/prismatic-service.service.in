# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=Prismatic configuration broker
Documentation=https://github.com/CoJoA13/Prismatic

[Service]
Type=dbus
BusName=io.github.CoJoA13.Prismatic.Service
ExecStart=@libexecdir@/prismatic-service
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ConfigurationDirectory=prismatic
CacheDirectory=prismatic

[Install]
WantedBy=default.target
